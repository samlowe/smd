{
  "permissions": {
    "allow": [
      "Bash(cargo check:*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.rs)",
      "Skill(post-change-think)",
      "Skill(docstrings)",
      "Subagent(*)"
    ],
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git add:*)",
      "Bash(git stash:*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(node_modules)",
      "Read(.claude/backups/)"
    ],
    "ask": [
      "Bash(mv:*)",
      "Bash(uv run:*)",
      "Bash(rm:*)",
      "Bash(ls -R:*)",
      "Bash(find /:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "execute_command",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r .tool_input.command | .claude/validate_bash.sh",
            "timeout": 15.0,
            "onError": "deny"
          }
        ]
      }
    ]
  }
}
