{
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "allow": ["Bash(prettier:*)", "Bash(rg:*)"],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(node_modules)",
      "Read(.claude/backups/)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r .tool_input.command | ${CLAUDE_PROJECT_DIR}/.claude/validate_bash.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | xargs ${CLAUDE_PROJECT_DIR}/.claude/format_typescript.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/backup_pre_compact.py"
          }
        ]
      },
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/backup_pre_compact.py"
          }
        ]
      }
    ]
  }
}
